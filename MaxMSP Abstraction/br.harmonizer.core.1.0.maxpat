                                    "parameter_enable": 0,
                                    "code": "// Restore the autogain, place the harmonies, equal-power dry/wet.\nParam stereo(0, min=0, max=1);\nParam mix(0.5, min=0, max=1);\nParam latency(0, min=0, max=96000);\nDelay restL(192000);\nDelay restR(192000);\nHistory stSm(0);\nHistory mixSm(0.5);\nst = stSm;\nmx = mixSm;\nkSm = exp(-1 / max(mstosamps(20), 1));\nst = stereo + kSm * (st - stereo);\nmx = mix + kSm * (mx - mix);\n// the restore gain is delayed by retune~'s latency (reported by the voices),\n// so it lines up with the shifted audio it belongs to\nrestL.write(in3);\nrestR.write(in4);\nwetL = in1 * restL.read(latency);\nwetR = in2 * restR.read(latency);\n// Mono: the left harmonies feed both sides\nwetR = wetL + st * (wetR - wetL);\ndryG = cos(mx * halfpi);\nwetG = sin(mx * halfpi);\nout1 = in5 * dryG + wetL * wetG;\nout2 = in6 * dryG + wetR * wetG;\nstSm = st;\nmixSm = mx;\n",
                                    "fontname": "Arial",
                                    "fontsize": 12.0
                                }
                            },
                            {
