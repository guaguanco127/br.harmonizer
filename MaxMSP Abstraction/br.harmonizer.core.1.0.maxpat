                                    ],
                                    "parameter_enable": 0,
                                    "code": "// Autogain: hold the input to retune~ near the target level:\n// quiet input is lifted above retune~'s threshold, loud input is turned\n// down so retune~ is never overdriven. out3/out4 = inverse gain for the mix.\nParam stereo(0, min=0, max=1);\nParam maxboost(30, min=0, max=48);\nParam target(-12, min=-48, max=0);\nParam rise(0, min=0, max=1000);\nParam fall(300, min=1, max=5000);\nHistory envL(0);\nHistory envR(0);\nHistory stSm(0);\n// read state first, write it last\neL = envL;\neR = envR;\nst = stSm;\n// ms -> per-sample coefficients at the current samplerate\nkRise = exp(-1 / max(mstosamps(rise), 1));\nkFall = exp(-1 / max(mstosamps(fall), 1));\nkSm = exp(-1 / max(mstosamps(20), 1));\nst = stereo + kSm * (st - stereo);\n// Mono: L+R, so a mic on one side keeps its full level. Stereo: L alone.\nsrcL = in1 + in2 * (1 - st);\nsrcR = in2;\naL = abs(srcL);\naR = abs(srcR);\neL = aL > eL ? aL + kRise * (eL - aL) : aL + kFall * (eL - aL);\neR = aR > eR ? aR + kRise * (eR - aR) : aR + kFall * (eR - aR);\n// instant rise (rise 0) = the boosted signal can't pass the target on an accent;\n// the boost cap keeps silence from being raised to full level\ntgt = dbtoa(target);\ncap = dbtoa(maxboost);\ngL = clamp(tgt / max(eL, 0.000001), 0.015, cap);\ngR = clamp(tgt / max(eR, 0.000001), 0.015, cap);\nout1 = srcL * gL;\nout2 = srcR * gR;\nout3 = 1 / gL;\nout4 = 1 / gR;\nenvL = eL;\nenvR = eR;\nstSm = st;\n",
                                    "fontname": "Arial",
                                    "fontsize": 12.0
                                }
                            },
